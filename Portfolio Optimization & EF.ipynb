 "cells": [
  {
   "cell_type": "markdown",
   "id": "dacc854e",
   "metadata": {},
   "source": [
    "Importing required Libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 240,
   "id": "cd7c98cb",
   "metadata": {},
   "outputs": [],
   "source": [
    "import yfinance as yf\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from datetime import datetime, timedelta\n",
    "from scipy.optimize import minimize\n",
    "import matplotlib.pyplot as plt\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3c960531",
   "metadata": {},
   "source": [
    "Define Tickers and Time Range"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 241,
   "id": "e7f82eed",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Defining the list of tickers\n",
    "tickers = ['ICICIBANK.NS', 'RELIANCE.NS', 'BHARTIARTL.NS', 'NTPC.NS']       \n",
    "\n",
    " # Setting end date to today\n",
    "end_date= datetime.today()                                                        \n",
    "# Setting the start date 10 years ago\n",
    "start_date= end_date - timedelta(days=365*10)                                      "
   ]
  },
  {
   "cell_type": "markdown",
   "id": "add94b4f",
   "metadata": {},
   "source": [
    "Download Adjusted Close Prices"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 242,
   "id": "3d7d5dee",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "[*********************100%***********************]  1 of 1 completed\n",
      "[*********************100%***********************]  1 of 1 completed\n",
      "[*********************100%***********************]  1 of 1 completed\n",
      "[*********************100%***********************]  1 of 1 completed\n"
     ]
    }
   ],
   "source": [
    "adj_close_df= pd.DataFrame()\n",
    "\n",
    "for ticker in tickers:\n",
    "    data= yf.download(ticker, start=start_date, end=end_date)\n",
    "    adj_close_df[ticker]= data['Close']"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "679f2d57",
   "metadata": {},
   "source": [
   <br>
    "Calculating Lognormal Returns and assigning weights to security"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 243,
   "id": "37da37c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# giving equal weights to each secuirty \n",
    "weights= np.array([1/len(tickers)]*len(tickers))              \n",
    "\n",
    "# Calculating log normal returns and dropping any NAs\n",
    "log_returns= np.log((adj_close_df/adj_close_df.shift(1)).dropna())    "
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cbc85fa2",
   "metadata": {},
   "source": [
    "Calculating Covariance Matrix"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 244,
   "id": "dc92bdf1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "               ICICIBANK.NS  RELIANCE.NS  BHARTIARTL.NS   NTPC.NS\n",
      "ICICIBANK.NS       0.084248     0.028229       0.025760  0.022259\n",
      "RELIANCE.NS        0.028229     0.072817       0.021901  0.019808\n",
      "BHARTIARTL.NS      0.025760     0.021901       0.082321  0.017765\n",
      "NTPC.NS            0.022259     0.019808       0.017765  0.066244\n"
     ]
    }
   ],
   "source": [
    "cov_matrix= log_returns.cov()*252\n",
    "print(cov_matrix)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4eadfca9",
   "metadata": {},
   "source": [
    "Defining Portfolio Performance Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 245,
   "id": "fae982d1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# We define functions to calculate the portfolio standard deviation, expected return, and Sharpe ratio\n",
    "\n",
    "def pf_sd(weights,cov_matrix):\n",
    "    variance= weights@cov_matrix@weights.T                   \n",
    "    return np.sqrt(variance)\n",
    "\n",
    "\n",
    "def exp_return(log_returns,weights):\n",
    "    return np.sum(weights*log_returns.mean())*252             \n",
    "\n",
    "\n",
    "def sharpe_ratio(weights,cov_matrix,log_returns,rf_rate):                \n",
    "    return (exp_return(log_returns,weights) - rf_rate)/(pf_sd(weights,cov_matrix))            \n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "18bbc22d",
   "metadata": {},
   "source": [
    "Portfolio Optimization Engine"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 246,
   "id": "51b8f8ea",
   "metadata": {},
   "outputs": [],
   "source": [
    "# set up the risk free rate assuming (6% p.a)\n",
    "rf_rate= 0.06                                  \n",
    "\n",
    "# define a function to minimize the negative Sharpe ratio\n",
    "def neg_sharpe_ratio(weights,cov_matrix,log_returns,rf_rate):\n",
    "    return -sharpe_ratio(weights,cov_matrix,log_returns,rf_rate)                       \n",
    "\n",
    "# set constraints and bounds for the optimization process\n",
    "constraints= {'type': 'eq', 'fun': lambda weights: np.sum(weights) - 1}               \n",
    "bounds= [(0,0.5) for _ in range (len(tickers))]\n",
    "\n",
    "optimal_results= minimize(neg_sharpe_ratio, weights, args=(cov_matrix,log_returns,rf_rate), method='SLSQP', constraints=constraints, bounds=bounds)     "
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bafb1026",
   "metadata": {},
   "source": [
    "Analyze the Optimal Portfolio"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 247,
   "id": "ed0a1215",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Optimal_Weights:\n",
      "ICICIBANK.NS: 26.2864\n",
      "RELIANCE.NS: 23.2142\n",
      "BHARTIARTL.NS: 41.1762\n",
      "NTPC.NS: 9.3233\n",
      "\n",
      "Optimized Results:\n",
      "Expected Annual Return: 18.3301 %\n",
      "Expected Volatility: 20.1988 %\n",
      "Sharpe Ratio: 61.0438 %\n"
     ]
    }
   ],
   "source": [
    "# We obtain the optimal weights and calculate the expected annual return, expected volatility, and Sharpe ratio for the optimal portfolio.\n",
    "\n",
    "optimal_weights= optimal_results.x               \n",
    "\n",
    "print('Optimal_Weights:')\n",
    "for ticker, weight in zip(tickers, optimal_weights*100):\n",
    "    print(f'{ticker}: {weight:.4f}')\n",
    "\n",
    "optimal_pf_return= (exp_return(log_returns,optimal_weights)*100)\n",
    "optimal_pf_sd= (pf_sd(optimal_weights,cov_matrix)*100)\n",
    "optimal_sharpe_ratio= (sharpe_ratio(optimal_weights,cov_matrix,log_returns,rf_rate)*100)\n",
    "\n",
    "print('\\nOptimized Results:')\n",
    "print(f\"Expected Annual Return: {optimal_pf_return:.4f} %\" )\n",
    "print(f\"Expected Volatility: {optimal_pf_sd:.4f} %\")\n",
    "print(f\"Sharpe Ratio: {optimal_sharpe_ratio:.4f} %\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "527612cd",
   "metadata": {},
   "source": [
    "Importing required Libraries for Efficient Frontier"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 248,
   "id": "1e8e5b46",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pypfopt.efficient_frontier import EfficientFrontier\n",
    "from pypfopt import risk_models\n",
    "from pypfopt import expected_returns\n",
    "from pypfopt import plotting\n",
    "plt.style.use('fivethirtyeight')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "500867dc",
   "metadata": {},
   "source": [
    "Efficient Frontier Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 249,
   "id": "8ea52454",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Annualize expected returns (252 trading days) and the covariance matrix\n",
    "mu= log_returns.mean()*252\n",
    "s = log_returns.cov()*252\n",
    "rf= 0.06  # Risk-free rate\n",
    "\n",
    "# Initialize the Efficient Frontier with weight bounds (e.g., max 50% allocation per asset)\n",
    "ef= EfficientFrontier(mu,s,weight_bounds=(0,0.5))\n",
    "# Optional constraint: Ensure portfolio asset weights sum to 1\n",
    "ef.add_constraint(lambda w: w[0]+w[1]+w[2]+w[3] == 1)\n",
    "\n",
    "# Create a deep copy of the EF object specifically to plot the theoretical curve later\n",
    "ef_for_plot= ef.deepcopy()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0e8a593f",
   "metadata": {},
   "source": [
    "Solving for maximum sharpe Ratio"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 250,
   "id": "83065dfb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PyPortfolioOpt weights\n",
      "ICICIBANK.NS: 26.2930%\n",
      "RELIANCE.NS: 23.2250%\n",
      "BHARTIARTL.NS: 41.1740%\n",
      "NTPC.NS: 9.3080%\n",
      "\n",
      "Optimized Results:\n",
      "Expected annual return: 18.3%\n",
      "Annual volatility: 20.2%\n",
      "Sharpe Ratio: 0.61\n"
     ]
    }
   ],
   "source": [
    "# 2. \n",
    "weights= ef.max_sharpe(risk_free_rate=rf)\n",
    "cleaned_weights= ef.clean_weights()\n",
    "\n",
    "# Print out the optimized asset allocations\n",
    "print(\"PyPortfolioOpt weights\")\n",
    "for ticker, weight in cleaned_weights.items():\n",
    "    print(f\"{ticker}: {weight*100:.4f}%\")\n",
    "\n",
    "# Retrieve performance metrics for the optimal Tangency Portfolio\n",
    "print('\\nOptimized Results:')\n",
    "ret_tangent,std_tangent,_= ef.portfolio_performance(verbose=True,risk_free_rate=rf)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "58bbd162",
   "metadata": {},
   "source": [
    "Plotting Efficient Frontier & Monte Carlo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 251,
   "id": "de9d1b96",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 880x560 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig, ax= plt.subplots(figsize=(11,7),dpi=80)\n",
    "\n",
    "# Plot the theoretical efficient frontier curve from PyPortfolioOpt\n",
    "plotting.plot_efficient_frontier(ef_for_plot,ax=ax, show_assets=False)\n",
    "\n",
    "# Run a Monte Carlo simulation generating 100,000 random portfolios using Dirichlet distribution\n",
    "n_samples= 100000\n",
    "w= np.random.dirichlet(np.ones(len(mu)),n_samples)\n",
    "rets= w.dot(mu)\n",
    "stds= np.sqrt(np.sum((w@ s)*w,axis=1))\n",
    "sharpe= (rets-rf)/stds\n",
    "\n",
    "# Scatter plot of random portfolios, colored by their respective Sharpe ratios\n",
    "sc= ax.scatter(stds, rets, marker='.',s=15,c= sharpe,alpha=0.2, cmap='viridis_r',zorder=1)\n",
    "\n",
    "# ADDED: Color bar to represent the color scale of the Sharpe ratios\n",
    "cbar = fig.colorbar(sc, ax=ax)\n",
    "cbar.set_label('Sharpe Ratio', fontsize=12)\n",
    "\n",
    "# Highlight the optimal Max Sharpe Ratio (tangency) portfolio on the chart\n",
    "ax.scatter(std_tangent,ret_tangent,marker='*', s=200, c='r',edgecolors='black', label='Max Sharpe',zorder=10)\n",
    "\n",
    "# Capital Allocation Line (CAL)\n",
    "\n",
    "# Plot the CAL starting from the risk-free rate out to the maximum simulated volatility\n",
    "x_cal = np.linspace(0.15, max(stds), 100)\n",
    "y_cal = rf + ((ret_tangent - rf) / std_tangent) * x_cal\n",
    "ax.plot(x_cal, y_cal, color='red', linestyle='--', linewidth=2, label='Capital Allocation Line (CAL)', zorder=5)\n",
    "\n",
    "\n",
    "# Chart Styling\n",
    "\n",
    "ax.set_title('Efficient Frontier with random Portfolios')\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
